generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                   String               @id @default(cuid())
  email                String               @unique
  password             String
  name                 String?
  phone                String?
  companyName          String?              @map("company_name")
  logoUrl              String?              @map("logo_url")
  logoPosition         String?              @default("left") @map("logo_position")
  logoWidth            Int?                 @default(100) @map("logo_width")
  logoOffsetX          Int?                 @default(0) @map("logo_offset_x")
  logoOffsetY          Int?                 @default(0) @map("logo_offset_y")
  avatarUrl            String?              @map("avatar_url")
  address              String?
  city                 String?
  state                String?
  pincode              String?
  gstNumber            String?              @map("gst_number")
  panNumber            String?              @map("pan_number")
  twoFactorEnabled     Boolean              @default(false) @map("two_factor_enabled")
  twoFactorSecret      String?              @map("two_factor_secret")
  twoFactorBackupCodes String?              @map("two_factor_backup_codes")
  permissions          String?              @default("[]")
  invitationToken      String?              @unique @map("invitation_token")
  invitationExpiry     DateTime?            @map("invitation_expiry")
  passwordSet          Boolean              @default(true) @map("password_set")
  roleId               String?              @map("role_id")
  isActive             Boolean              @default(true) @map("is_active")
  isVerified           Boolean              @default(false) @map("is_verified")
  lastLoginAt          DateTime?            @map("last_login_at")
  passwordChangedAt    DateTime?            @map("password_changed_at")
  passwordExpiresAt    DateTime?            @map("password_expires_at")
  failedLoginAttempts  Int                  @default(0) @map("failed_login_attempts")
  lockedUntil          DateTime?            @map("locked_until")
  googleId             String?              @unique @map("google_id")
  oauthProvider        String?              @map("oauth_provider")
  planType             PlanType             @default(FREE)
  planExpiresAt        DateTime?            @map("plan_expires_at")
  parentId             String?              @map("parent_id")
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")
  customColumns        String?              @default("[\"Product Name\", \"Quantity\", \"Price\", \"Total\"]")
  isEmployee           Int                  @default(0) @map("is_employee")
  apiKeys              ApiKey[]
  bills                Bill[]
  custom_columns       custom_columns[]
  customers            Customer[]
  dynamicFeatureFlags  DynamicFeatureFlag[]
  notifications        Notification[]
  passwordHistory      PasswordHistory[]
  products             Product[]
  securityLogs         SecurityLog[]
  serviceTickets       ServiceTicket[]
  services             Service[]
  settingStates        SettingState[]
  suppliers            Supplier[]
  sessions             UserSession[]
  purchaseOrders       PurchaseOrder[]
  parent               User?                @relation("UserToSubUser", fields: [parentId], references: [id])
  subUsers             User[]               @relation("UserToSubUser")
  role                 Role?                @relation(fields: [roleId], references: [id])

  @@map("users")
}

model Customer {
  id              String          @id @default(cuid())
  userId          String          @map("user_id")
  name            String
  email           String?
  phone           String?
  address         String?
  gstNumber       String?         @map("gst_number")
  dob             DateTime?       @map("dob")
  anniversaryDate DateTime?       @map("anniversary_date")
  loyaltyPoints   Float           @default(0) @map("loyalty_points")
  isActive        Boolean         @default(true) @map("is_active")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  isMarkedRed     Boolean         @default(false) @map("is_marked_red")
  city            String?
  pincode         String?
  state           String?
  bills           Bill[]
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceTickets  ServiceTicket[]

  @@index([userId])
  @@index([name])
  @@map("customers")
}

model Product {
  id            String     @id @default(cuid())
  userId        String     @map("user_id")
  name          String
  description   String?
  price         Float
  taxRate       Float?     @default(0) @map("tax_rate")
  stock         BigInt?    @default(0)
  category      String?
  sku           String?
  minStockLevel Int?       @default(0) @map("min_stock_level")
  expiryDate    DateTime?  @map("expiry_date")
  batchNumber   String?    @map("batch_number")
  supplierId    String?    @map("supplier_id")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")
  isMarkedRed   Boolean    @default(false) @map("is_marked_red")
  imageUrl      String?    @map("image_url")
  customFields  String?    @map("custom_fields")
  billItems          BillItem[]
  purchaseOrderItems PurchaseOrderItem[]
  supplier           Supplier?           @relation(fields: [supplierId], references: [id])
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([name])
  @@index([stock])
  @@index([supplierId])
  @@index([category])
  @@index([sku])
  @@map("products")
}

model Service {
  id             String          @id @default(cuid())
  userId         String          @map("user_id")
  name           String
  description    String?
  price          Float
  taxRate        Float?          @default(0) @map("tax_rate")
  category       String?
  duration       String?
  isActive       Boolean         @default(true) @map("is_active")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  billItems      BillItem[]
  serviceTickets ServiceTicket[]
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([name])
  @@map("services")
}

model Bill {
  id                 String        @id @default(cuid())
  userId             String        @map("user_id")
  customerId         String?       @map("customer_id")
  billNumber         String        @unique @map("bill_number")
  customerName       String        @map("customer_name")
  customerEmail      String?       @map("customer_email")
  status             BillStatus    @default(DRAFT)
  subtotal           Float
  taxAmount          Float         @default(0) @map("tax_amount")
  totalAmount        Float         @map("total_amount")
  dueDate            DateTime?     @map("due_date")
  notes              String?
  templateId         String?       @default("standard") @map("template_id")
  paymentStatus      PaymentStatus @default(PENDING) @map("payment_status")
  paidAmount         Float         @default(0) @map("paid_amount")
  dueAmount          Float?        @map("due_amount")
  qrCodeUrl          String?       @map("qr_code_url")
  isWhatsAppSent     Boolean       @default(false) @map("is_whatsapp_sent")
  isNotificationRead Boolean       @default(false) @map("is_notification_read")
  columnsSnapshot    String?       @map("columns_snapshot")
  branchId           String?       @map("branch_id")
  supplierId         String?       @map("supplier_id")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")
  items              BillItem[]
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  customer           Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  branch             Branch?       @relation(fields: [branchId], references: [id])
  supplier           Supplier?     @relation(fields: [supplierId], references: [id])

  @@index([userId, createdAt])
  @@index([userId, customerName])
  @@index([customerId])
  @@index([status])
  @@map("bills")
}

model BillItem {
  id            String   @id @default(cuid())
  billId        String   @map("bill_id")
  productId     String?  @map("product_id")
  productName   String   @map("product_name")
  quantity      BigInt
  price         Float
  total         Float
  taxId         String?  @map("tax_id")
  taxRate       Float?   @default(0) @map("tax_rate")
  taxAmount     Float?   @default(0) @map("tax_amount")
  isService     Boolean  @default(false) @map("is_service")
  serviceId     String?  @map("service_id")
  custom_fields String?
  tax           Tax?     @relation(fields: [taxId], references: [id])
  service       Service? @relation(fields: [serviceId], references: [id])
  product       Product? @relation(fields: [productId], references: [id])
  bill          Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@map("bill_items")
}

model Role {
  id                  String               @id @default(cuid())
  name                UserRole             @unique
  displayName         String               @map("display_name")
  description         String?
  isActive            Boolean              @default(true) @map("is_active")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  dynamicFeatureFlags DynamicFeatureFlag[]
  rolePermissions     RolePermission[]
  users               User[]

  @@map("roles")
}

model RolePermission {
  id         String     @id @default(cuid())
  roleId     String     @map("role_id")
  permission Permission
  canRead    Boolean    @default(false) @map("can_read")
  canWrite   Boolean    @default(false) @map("can_write")
  canDelete  Boolean    @default(false) @map("can_delete")
  createdAt  DateTime   @default(now()) @map("created_at")
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permission])
  @@map("role_permissions")
}

model UserSession {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  sessionId  String   @unique @map("session_id")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  deviceInfo String?  @map("device_info")
  isActive   Boolean  @default(true) @map("is_active")
  expiresAt  DateTime @map("expires_at")
  lastUsedAt DateTime @default(now()) @map("last_used_at")
  createdAt  DateTime @default(now()) @map("created_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_sessions")
}

model ApiKey {
  id          String      @id @default(cuid())
  userId      String      @map("user_id")
  name        String
  keyHash     String      @unique @map("key_hash")
  keyPrefix   String      @map("key_prefix")
  scope       ApiKeyScope @default(READ_ONLY)
  permissions String?
  isActive    Boolean     @default(true) @map("is_active")
  lastUsedAt  DateTime?   @map("last_used_at")
  expiresAt   DateTime?   @map("expires_at")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("api_keys")
}

model SecurityLog {
  id          String            @id @default(cuid())
  userId      String?           @map("user_id")
  eventType   SecurityEventType @map("event_type")
  description String
  ipAddress   String?           @map("ip_address")
  userAgent   String?           @map("user_agent")
  metadata    String?
  success     Boolean           @default(true)
  createdAt   DateTime          @default(now()) @map("created_at")
  user        User?             @relation(fields: [userId], references: [id])

  @@map("security_logs")
}

model PasswordHistory {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_history")
}

model FeatureFlag {
  id            String    @id @default(cuid())
  name          String    @unique
  displayName   String    @map("display_name")
  description   String?
  isEnabled     Boolean   @default(false) @map("is_enabled")
  isPaidFeature Boolean   @default(false) @map("is_paid_feature")
  requiredPlan  PlanType? @map("required_plan")
  metadata      String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("feature_flags")
}

model OrganizationSettings {
  id                       String   @id @default(cuid())
  defaultInvoiceTemplateId String?  @default("standard") @map("default_invoice_template_id")
  twoFactorRequired        Boolean  @default(false) @map("two_factor_required")
  oauthEnabled             Boolean  @default(false) @map("oauth_enabled")
  rbacEnabled              Boolean  @default(false) @map("rbac_enabled")
  apiKeysEnabled           Boolean  @default(false) @map("api_keys_enabled")
  passwordMinLength        Int      @default(8) @map("password_min_length")
  passwordRequireUppercase Boolean  @default(true) @map("password_require_uppercase")
  passwordRequireNumbers   Boolean  @default(true) @map("password_require_numbers")
  passwordRequireSpecial   Boolean  @default(true) @map("password_require_special")
  passwordExpiryDays       Int?     @map("password_expiry_days")
  passwordHistoryCount     Int      @default(5) @map("password_history_count")
  sessionTimeoutMinutes    Int      @default(1440) @map("session_timeout_minutes")
  maxConcurrentSessions    Int      @default(5) @map("max_concurrent_sessions")
  maxFailedAttempts        Int      @default(5) @map("max_failed_attempts")
  lockoutDurationMinutes   Int      @default(30) @map("lockout_duration_minutes")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  @@map("organization_settings")
}

model Tax {
  id           String     @id @default(cuid())
  name         String     @unique
  displayName  String     @map("display_name")
  rate         Float
  description  String?
  type         TaxType    @default(PERCENTAGE)
  isDefault    Boolean    @default(false) @map("is_default")
  isActive     Boolean    @default(true) @map("is_active")
  applicableTo String?    @map("applicable_to")
  region       String?
  metadata     String?
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  billItems    BillItem[]

  @@map("taxes")
}

model Settings {
  id              String         @id @default(cuid())
  category        String
  key             String
  value           String
  valueType       ValueType      @default(STRING)
  displayName     String         @map("display_name")
  description     String?
  isSystemSetting Boolean        @default(false) @map("is_system_setting")
  isUserEditable  Boolean        @default(true) @map("is_user_editable")
  validation      String?
  defaultValue    String?        @map("default_value")
  group           String?
  order           Int            @default(0)
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  autoGenerateInvoiceNumbers Boolean? @default(true)
  showLogo                  Boolean? @default(true)
  sendEmailNotifications     Boolean? @default(false)
  showPaymentTerms           Boolean? @default(true)
  includeTaxBreakdown        Boolean? @default(true)
  requireApproval            Boolean? @default(false)
  primaryColor               String?  @default("#3b82f6")
  customColumns              String?  @default("[\"Product Name\", \"Quantity\", \"Price\", \"Total\"]")
  settingStates   SettingState[]

  @@unique([category, key])
  @@map("settings")
}

model SettingState {
  id        String   @id @default(cuid())
  settingId String   @map("setting_id")
  userId    String?  @map("user_id")
  value     String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  setting   Settings @relation(fields: [settingId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([settingId, userId])
  @@map("setting_states")
}

model DynamicFeatureFlag {
  id          String        @id @default(cuid())
  module      FeatureModule
  feature     String
  displayName String        @map("display_name")
  description String?
  isEnabled   Boolean       @default(true) @map("is_enabled")
  isVisible   Boolean       @default(true) @map("is_visible")
  isEditable  Boolean       @default(true) @map("is_editable")
  isRequired  Boolean       @default(false) @map("is_required")
  order       Int           @default(0)
  conditions  String?
  metadata    String?
  userId      String?       @map("user_id")
  roleId      String?       @map("role_id")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  user        User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        Role?         @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([module, feature, userId])
  @@unique([module, feature, roleId])
  @@map("dynamic_feature_flags")
}

model DailyMetric {
  id           String   @id @default(cuid())
  date         DateTime @unique @map("date")
  revenue      Float    @default(0)
  billsPaid    Int      @default(0) @map("bills_paid")
  billsOverdue Int      @default(0) @map("bills_overdue")
  newCustomers Int      @default(0) @map("new_customers")
  newProducts  Int      @default(0) @map("new_products")
  activeUsers  Int      @default(0) @map("active_users")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("daily_metrics")
}

model CronJobLog {
  id               String    @id @default(cuid())
  jobName          String    @map("job_name")
  status           JobStatus @default(RUNNING)
  startedAt        DateTime  @default(now()) @map("started_at")
  completedAt      DateTime? @map("completed_at")
  duration         Int?
  recordsProcessed Int?      @default(0) @map("records_processed")
  errorMessage     String?   @map("error_message")
  metadata         String?
  createdAt        DateTime  @default(now()) @map("created_at")

  @@map("cron_job_logs")
}

model Supplier {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  name      String
  contact   String?
  email     String?
  phone     String?
  address   String?
  state     String?
  city      String?
  pincode   String?
  gstNumber String?   @map("gst_number")
  isActive  Boolean   @default(true) @map("is_active")
  balance   Float     @default(0)
  branchId  String?   @map("branch_id")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  isMarkedRed Boolean   @default(false) @map("is_marked_red")
  bills          Bill[]
  products       Product[]
  purchaseOrders PurchaseOrder[]
  branch         Branch?         @relation(fields: [branchId], references: [id])
  users     User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("suppliers")
}

model Branch {
  id        String     @id @default(cuid())
  userId    String     @map("user_id")
  name      String
  code      String     @unique
  address   String?
  phone     String?
  email     String?
  isActive  Boolean    @default(true) @map("is_active")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  bills     Bill[]
  suppliers Supplier[]

  @@map("branches")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  oldData   String?  @map("old_data")
  newData   String?  @map("new_data")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  branchId  String?  @map("branch_id")
  timestamp DateTime @default(now())
  createdAt DateTime @default(now()) @map("created_at")
  subUserId String?  @map("sub_user_id")
  userName  String?  @map("user_name")

  @@index([userId])
  @@index([subUserId])
  @@map("audit_logs")
}

model Expense {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  title         String
  category      String
  amount        Float
  gstAmount     Float?   @default(0) @map("gst_amount")
  date          DateTime @default(now())
  attachmentUrl String?  @map("attachment_url")
  description   String?
  branchId      String?  @map("branch_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("expenses")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  message   String
  type      String
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notifications")
}

model Lead {
  id        String     @id @default(cuid())
  name      String
  email     String?
  phone     String?
  message   String?
  status    LeadStatus @default(NEW)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  @@map("leads")
}

model DemoRequest {
  id          String     @id @default(cuid())
  name        String
  email       String?
  phone       String?
  companyName String?    @map("company_name")
  status      DemoStatus @default(PENDING)
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  @@map("demo_requests")
}

model ServiceTicket {
  id          String              @id @default(cuid())
  userId      String              @map("user_id")
  customerId  String?             @map("customer_id")
  serviceId   String              @map("service_id")
  status      ServiceTicketStatus @default(OPEN)
  description String?
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")
  service     Service             @relation(fields: [serviceId], references: [id])
  customer    Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([customerId])
  @@index([serviceId])
  @@map("service_tickets")
}

model custom_columns {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  name       String
  label      String
  type       String   @default("text")
  entity     String
  required   Boolean  @default(false)
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt      @map("updated_at")
  users      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ImportJob {
  id                String   @id @default(cuid())
  userId            String   @map("user_id")
  status            String   @default("pending")
  totalProducts     Int      @default(0) @map("total_products")
  processedProducts Int      @default(0) @map("processed_products")
  failedProducts    Int      @default(0) @map("failed_products")
  errorMessage      String?  @map("error_message")
  errorLog          String?  @map("error_log")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("import_jobs")
}

enum BillStatus {
  DRAFT
  PENDING
  PENDING_APPROVAL
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentStatus {
  PAID
  PARTIAL
  PENDING
}

enum PlanType {
  FREE
  BASIC
  PREMIUM
  ENTERPRISE
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  ACCOUNTANT
  VIEWER
  FINANCE
  OPERATOR
  TECHNICIAN
  READONLY
}

enum Permission {
  BILLING_READ
  BILLING_WRITE
  BILLING_DELETE
  CUSTOMERS_READ
  CUSTOMERS_WRITE
  CUSTOMERS_DELETE
  PRODUCTS_READ
  PRODUCTS_WRITE
  PRODUCTS_DELETE
  REPORTS_READ
  REPORTS_EXPORT
  API_READ
  API_WRITE
  ADMIN_SETTINGS
  USER_MANAGEMENT
}

enum ApiKeyScope {
  READ_ONLY
  READ_WRITE
  ADMIN
}

enum SecurityEventType {
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGOUT
  PASSWORD_CHANGE
  PASSWORD_RESET
  TWO_FACTOR_ENABLED
  TWO_FACTOR_DISABLED
  TWO_FACTOR_SUCCESS
  TWO_FACTOR_FAILED
